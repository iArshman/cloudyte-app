<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="sharedpref" path="cloudyte_secure_prefs.xml" />
    <exclude domain="sharedpref" path="cloudyte_secure_fallback.xml" />
    <exclude domain="sharedpref" path="cloudyte_prefs.xml" />
    <exclude domain="sharedpref" path="cloudyte_drive_state.xml" />
    <exclude domain="sharedpref" path="sync_logger_prefs.xml" />
    <exclude domain="sharedpref" path="cloudyte_audio_playback.xml" />
    <exclude domain="database" path="cloud_app_database" />
    <exclude domain="database" path="cloud_app_database-wal" />
    <exclude domain="database" path="cloud_app_database-shm" />
    <exclude domain="file" path="offline_vault" />
    <exclude domain="file" path="crypto" />
    <exclude domain="file" path="cloudyte_thumbnails" />
    <exclude domain="file" path="datastore" />
    <exclude domain="file" path="logs" />
</full-backup-content>
