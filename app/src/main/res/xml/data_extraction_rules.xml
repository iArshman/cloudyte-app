<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cloudyte_secure_prefs.xml" />
        <exclude domain="sharedpref" path="cloudyte_secure_fallback.xml" />
        <exclude domain="sharedpref" path="cloudyte_prefs.xml" />
        <exclude domain="database" path="cloud_app_database" />
        <exclude domain="file" path="offline_vault" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cloudyte_secure_prefs.xml" />
        <exclude domain="sharedpref" path="cloudyte_secure_fallback.xml" />
        <exclude domain="sharedpref" path="cloudyte_prefs.xml" />
        <exclude domain="database" path="cloud_app_database" />
        <exclude domain="file" path="offline_vault" />
    </device-transfer>
</data-extraction-rules>
